<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build = install. Running `dotnet build -c Release` (or build.bat):
      1. compiles DupeTimeline.dll against the local ONI install,
      2. ILRepacks PeterHan's PLib into the same DLL (so we ship a
         single DLL, no separate PLib.dll alongside),
      3. copies DupeTimeline.dll + mod.yaml + mod_info.yaml into
         %USERPROFILE%\Documents\Klei\OxygenNotIncluded\mods\Local\DupeTimeline.

    Override the auto-detected paths with:
      dotnet build -c Release -p:GameFolder="D:\..\OxygenNotIncluded_Data\Managed"
      dotnet build -c Release -p:CopyToMods=false   (build only, no install)
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>DupeTimeline</AssemblyName>
    <RootNamespace>DupeTimeline</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <GameFolder Condition="'$(GameFolder)' == '' AND Exists('$(MSBuildProgramFiles32)\Steam\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed')">$(MSBuildProgramFiles32)\Steam\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed</GameFolder>
    <GameFolder Condition="'$(GameFolder)' == '' AND Exists('C:\Program Files\Steam\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed')">C:\Program Files\Steam\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed</GameFolder>
    <GameFolder Condition="'$(GameFolder)' == '' AND Exists('D:\SteamLibrary\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed')">D:\SteamLibrary\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed</GameFolder>
    <GameFolder Condition="'$(GameFolder)' == '' AND Exists('E:\SteamLibrary\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed')">E:\SteamLibrary\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed</GameFolder>

    <ModInstallFolder Condition="'$(ModInstallFolder)' == ''">$(USERPROFILE)\Documents\Klei\OxygenNotIncluded\mods\Local\DupeTimeline</ModInstallFolder>
  </PropertyGroup>

  <Target Name="ValidateGameFolder" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameFolder)')"
           Text="
[DupeTimeline] Could not locate Oxygen Not Included install at any of:
  $(MSBuildProgramFiles32)\Steam\steamapps\common\OxygenNotIncluded
  C:\Program Files\Steam\steamapps\common\OxygenNotIncluded
  D:\SteamLibrary\steamapps\common\OxygenNotIncluded
  E:\SteamLibrary\steamapps\common\OxygenNotIncluded
Set the path explicitly:
  dotnet build -c Release -p:GameFolder=&quot;C:\path\to\OxygenNotIncluded\OxygenNotIncluded_Data\Managed&quot;
GameFolder must point at the directory containing Assembly-CSharp.dll." />
  </Target>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameFolder)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameFolder)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameFolder)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameFolder)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameFolder)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameFolder)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameFolder)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameFolder)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameFolder)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameFolder)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      PLib is bundled into our DLL via ILRepack below. PrivateAssets=all
      keeps it out of any consumers; IncludeAssets is left at the default
      (all) so the compiler sees PLib types and PLib.dll lands in the
      output directory for ILRepack to merge.
    -->
    <PackageReference Include="PLib" Version="4.24.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.40">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="mod.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="mod_info.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ILRepacker" AfterTargets="Build">
    <ItemGroup>
      <ILRepackInputs Include="$(TargetPath)" />
      <ILRepackInputs Include="$(TargetDir)PLib.dll" Condition="Exists('$(TargetDir)PLib.dll')" />
    </ItemGroup>
    <!--
      LibraryPath tells ILRepack where to resolve referenced assemblies
      (Assembly-CSharp, Unity engine modules, etc.) that aren't in the
      input set. Without this it can't follow type references inside our
      DLL or PLib's, and the merge fails with "Failed to resolve assembly".
    -->
    <ILRepack
      Parallel="true"
      Internalize="true"
      InputAssemblies="@(ILRepackInputs)"
      OutputFile="$(TargetPath)"
      LibraryPath="$(GameFolder);$(TargetDir)"
      Condition="'@(ILRepackInputs->Count())' &gt; '1'"
    />
    <Delete Files="$(TargetDir)PLib.dll" Condition="Exists('$(TargetDir)PLib.dll')" />
    <Message Importance="high" Text="ILRepacked PLib into $(TargetPath)" />
  </Target>

  <Target Name="InstallToMods" AfterTargets="ILRepacker" Condition="'$(CopyToMods)' != 'false'">
    <MakeDir Directories="$(ModInstallFolder)" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildThisFileDirectory)mod.yaml;$(MSBuildThisFileDirectory)mod_info.yaml"
          DestinationFolder="$(ModInstallFolder)"
          SkipUnchangedFiles="false" />
    <Message Importance="high" Text="Installed DupeTimeline -> $(ModInstallFolder)" />
  </Target>

</Project>
